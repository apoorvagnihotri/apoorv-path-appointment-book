# Example environment configuration for local development (Vite)
# Copy this file to ".env.local" and fill in the values:
#   cp .env.example .env.local
#
# Notes:
# - Variables that must be exposed to the browser must be prefixed with VITE_ (Vite convention).
# - Do not commit .env.local; it's ignored by .gitignore.
# - In Vercel, create these same variables in Project Settings → Environment Variables.

# Required for the web app (frontend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: used by local scripts or Supabase functions tooling.
# Never expose service role keys to the browser or commit real values.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: Vercel / build-time hints
# You generally don't need to set these locally, but they can be useful.
# NODE_ENV=development

# Troubleshooting
# If you see "supabaseUrl is required" in the browser console:
# 1) Ensure .env.local exists and contains the two VITE_ variables above.
# 2) Restart the dev server after editing env files.
# 3) For Vercel deployments, set the same keys in the dashboard and redeploy.

# End of file